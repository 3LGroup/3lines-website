node_modules/
.next/
audit-runs/
.server.log
next-env.d.ts
*.tsbuildinfo

# Real secrets never get committed; .env.example is the documented template.
.env
.env.local
.env.*.local

# Written by `vercel link` — carries the project and org IDs, not shared config.
.vercel

# Cloudflare. `.open-next/` is the adapter's build output, `.wrangler/` holds
# local D1/R2 state, and `.dev.vars` is the local secret file — the Workers
# equivalent of .env.local, and just as much a thing that must never be pushed.
.open-next/
.wrangler/
# Regenerated deterministically from content/ by scripts/import-to-cms.mjs.
# Half a megabyte of INSERT statements is an application step, not a reviewable
# artifact — the reviewable things are the script and content/, both committed.
drizzle/seed/
.dev.vars
.dev.vars.*
!.dev.vars.example

# Real enquiries, with real email addresses. Nothing in this app reads or writes
# them — they are residue from running the legacy JSON-backed site in this same
# working directory, and they have never been tracked in any branch. Ignored
# rather than deleted because they are the only copy of that data until the CMS
# imports them into form_submissions; ignored rather than left alone because
# until now a single `git add -A` would have published personal data.
content/contact-messages.json
content/subscribers.json

# baseline/ is deliberately NOT ignored — the committed geometry snapshot is the
# visual audit's reference, and updating it is meant to be a reviewable diff.

# Local dev server logs
.server-*.log

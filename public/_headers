# Cloudflare Workers Static Assets header rules.
#
# Baseline security headers.
#
# These reach STATIC ASSET responses only. Workers Static Assets applies this file to
# what it serves itself; a response produced by the Worker — every HTML page, /admin,
# /preview, /api — never passes through it. Verified against production: /admin/login
# comes back with `x-opennext: 1` and NO X-Robots-Tag, despite the /admin/* rule below
# having been here all along.
#
# So the equivalent headers for pages live in next.config.mjs headers(), which Next
# applies inside the Worker. Both exist deliberately: this file covers the asset
# responses that never reach Next at all.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Next content-hashes everything under /_next/static/, so those URLs are immutable
# by construction and can be cached for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The hand-authored assets are versioned a different way: lib/assets.ts appends
# ?v=<sha1 of the file's bytes>, so editing one changes its URL. Same immutability
# guarantee, so the same policy applies. scripts/audit-assets.mjs is what enforces
# that the served HTML advertises the current hash.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Kept for any static asset served from under /admin. It does NOT cover the admin
# pages themselves — those are Worker responses and never see this file (see the note
# at the top). The page-level guarantee is the route's own noindex metadata plus the
# X-Robots-Tag in next.config.mjs headers(); robots.txt is the third layer.
/admin/*
  X-Robots-Tag: noindex, nofollow

# Same situation as /admin: this catches assets under /preview, not the preview pages,
# which are Worker-rendered. The preview route renders unpublished content through the
# real public renderer, so an indexed preview URL would put a draft of the live site in
# search results — the layers that actually cover it are next.config.mjs headers(),
# robots.txt, and the route's own metadata.
/preview/*
  X-Robots-Tag: noindex, nofollow

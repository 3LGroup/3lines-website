{
  "name": "thales-group-clone",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "extract": "node scripts/extract-non-cms.mjs",
    "ingest": "node scripts/ingest-3lines.mjs",
    "audit:content": "node scripts/audit-content.mjs",
    "audit:localization": "node scripts/audit-localization.mjs",
    "audit:manifest": "node scripts/audit-manifest.mjs",
    "audit:admin": "node scripts/audit-admin.mjs",
    "audit:links": "node scripts/audit-links.mjs",
    "audit:console": "node scripts/audit-console.mjs",
    "audit:visual": "node scripts/audit-visual.mjs",
    "dev": "next dev -p 3200",
    "assets:manifest": "node scripts/build-asset-manifest.mjs",
    "prebuild": "node scripts/build-asset-manifest.mjs",
    "build": "next build",
    "start": "next start -p 3200",
    "typecheck": "tsc --noEmit",
    "cf:build": "npm run cf:prebuild && npm run assets:manifest && opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:import": "node scripts/import-to-cms.mjs",
    "db:import:local": "npm run db:import && wrangler d1 execute 3lines-cms --local --file=drizzle/seed/content.sql",
    "db:import:remote": "npm run db:import && wrangler d1 execute 3lines-cms --remote --file=drizzle/seed/content.sql",
    "db:migrate:local": "wrangler d1 migrations apply 3lines-cms --local",
    "db:migrate:remote": "wrangler d1 migrations apply 3lines-cms --remote",
    "verify": "node scripts/pipeline.mjs",
    "baseline:update": "node scripts/visual-baseline.mjs",
    "audit:assets": "node scripts/audit-assets.mjs",
    "db:export": "node scripts/export-content.mjs",
    "db:export:remote": "node scripts/export-content.mjs --remote",
    "cf:prebuild": "node scripts/cf-prebuild.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "drizzle-orm": "^0.45.2",
    "next": "15.5.23",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "cheerio": "1.0.0",
    "drizzle-kit": "^0.31.10",
    "puppeteer-core": "23.11.1",
    "typescript": "5.7.2",
    "wrangler": "^4.123.0"
  }
}

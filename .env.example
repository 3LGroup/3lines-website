# Canonical origin for sitemap.xml, canonical tags, hreflang and JSON-LD.
# Change this once before go-live; nothing else needs editing.
SITE_ORIGIN=https://www.3lines.com.sa

# Where the contact form forwards to. The route handler FAILS CLOSED with a 503
# when this is unset — it never pretends a message was delivered.
CONTACT_ENDPOINT=https://3lines.com.sa/api/v1/contact
CONTACT_TIMEOUT_MS=8000

# --- /admin -----------------------------------------------------------------
# Generate both, never hand-write them:
#
#   node scripts/admin-credentials.mjs secret
#   node scripts/admin-credentials.mjs password "<a long password>"
#
# In production these are Cloudflare secrets, not variables:
#   npx wrangler secret put SESSION_SECRET
#   npx wrangler secret put CMS_PASSWORD_HASH
# A secret set that way cannot be read back from the dashboard, which is the
# point. Note that `wrangler deploy` wipes dashboard-set vars unless you pass
# --keep-vars.

# HMAC key for the session cookie. Minimum 32 chars; lib/admin/session.ts throws
# rather than falling back to a default, because signing with a known constant
# is indistinguishable from not signing at all.
SESSION_SECRET=

# PBKDF2 hash of the admin password — never the password itself.
# Format: pbkdf2-sha256.<iterations>.<salt>.<derived>, all base64url.
# Dot-separated on purpose: Next loads .env through dotenv-expand, so a `$` in
# the value is interpolated away and the hash silently arrives corrupt. Do not
# "fix" the format back to the conventional $-separated one.
CMS_PASSWORD_HASH=

# Optional. Names the operator in the session and, from M7, in the audit log.
CMS_USER=admin

# Optional. Bumping it invalidates every issued session cookie at once — the
# revoke-all that a stateless session otherwise cannot do.
SESSION_VERSION=1
